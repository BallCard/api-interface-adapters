# Local environment template for a clean Claude-compatible bridge
# Copy these values into your real environment or a .env loader.

# Upstream relay / proxy endpoint
UPSTREAM_BASE_URL=https://sakura886.site
UPSTREAM_API_KEY=replace_me

# Local proxy listen address
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# Claude model mappings
MODEL_HAIKU=claude-sonnet-4-6
MODEL_SONNET=claude-sonnet-4-6
MODEL_OPUS=claude-opus-4-7,claude-sonnet-4-6
MODEL_MULTIMODAL=claude-sonnet-4-6

# Chat behavior
DEFAULT_SESSION=default
DEFAULT_MODEL=opus
MAX_HISTORY_MESSAGES=40
DEFAULT_MAX_TOKENS=1024
DEFAULT_SYSTEM_PROMPT=You are a clear, thoughtful conversation partner. Be natural, intelligent, and direct. Do not add project-management, coding-agent, or tool-usage framing unless the user explicitly asks for it.
