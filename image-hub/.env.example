# The management UI writes real keys to the ignored .env.local file.
# Each channel has an independent key. Do not put keys in channels.local.json.
IMAGE_HUB_SAKURA_API_KEY=replace_me
IMAGE_HUB_OPENAI_OFFICIAL_API_KEY=replace_me
IMAGE_HUB_BACKUP_RELAY_API_KEY=replace_me

HOST=127.0.0.1
PORT=4100
IMAGE_HUB_DATA_DIR=./data
IMAGE_HUB_CONFIG_PATH=./channels.local.json
# Optional. Defaults to the parent Workspace directory of this repository.
IMAGE_HUB_WORKSPACE_ROOT=D:\Workspace
